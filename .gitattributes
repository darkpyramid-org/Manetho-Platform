# Normalize line endings so the repository behaves the same on
# Windows, macOS and Linux, and so diffs stay clean.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

*.svg text eol=lf
*.webmanifest text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary