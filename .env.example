# ─────────────────────────────────────────────────────────────
# MANETHO — environment configuration
# Copy to .env.local (or .env) and fill in values.
# Never commit a real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). When unset, Manetho runs on the built-in
# in-memory development repository populated with seed data, and
# simply skips writing readings to storage.
DATABASE_URL=
# Prisma Postgres example:
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# App
APP_URL=http://localhost:3000
APP_NAME=Manetho
NODE_ENV=development

# Feature flags (see lib/features.ts)
ENABLE_TRANSLATOR=true
ENABLE_AI_ASSISTANT=true
ENABLE_VOICE=true
ENABLE_MUSEUM_MAP=true
ENABLE_AR=false
ENABLE_VR=false
ENABLE_LEARNING=true
ENABLE_RESEARCH_MODE=true
ENABLE_OFFLINE_MODE=true

# AI provider: mock | openai | huawei | local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
VISION_MODEL=
EMBEDDING_MODEL=
STT_PROVIDER=browser
TTS_PROVIDER=browser

# OpenAI (optional production provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Huawei Cloud ModelArts (optional production provider).
HUAWEI_API_KEY=
HUAWEI_BASE_URL=https://api.huaweicloud.com/v1
HUAWEI_VISION_MODEL=glm-4v
HUAWEI_CHAT_MODEL=glm-4

# Local model server (Ollama-compatible)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_CHAT_MODEL=llama3
LOCAL_VISION_MODEL=llava

# Redis (optional; rate limits / cache in production)
REDIS_URL=

# Auth
AUTH_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible object storage (optional in development)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=manetho-dev

# Maps
MAP_PROVIDER=svg
MAP_TOKEN=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Demo labeling for AI output (prefer false when AI_PROVIDER is not mock)
DEMO_MODE=true

# Demo admin elevation (optional). Set a strong random value, then send
# header x-manetho-admin-secret or cookie manetho_admin with the same value
# to obtain CONTENT_EDITOR for admin write UI. Local/demo only.
DEMO_ADMIN_SECRET=

# When true in production, guests cannot access admin; AUTH_SECRET must not
# be the example default. Also used by instrumentation env guards.
AUTH_ENABLED=false
REQUIRE_AUTH=false

# AI rate limits (per IP, sliding window)
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MS=900000
